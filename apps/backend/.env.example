# ==============================================================================
# 1688 LISTING SYNC HUB - BACKEND CONFIGURATION TEMPLATE
# ==============================================================================

PORT=3001
NODE_ENV=production
DEMO_MODE=false
ADMIN_API_TOKEN=
EXTENSION_API_KEY=
CRON_SECRET=
CORS_ALLOWED_ORIGINS=https://admin.example.com,chrome-extension://your-extension-id
JSON_BODY_LIMIT=5mb
OUTBOUND_TIMEOUT_MS=8000
OUTBOUND_MAX_BYTES=5242880

# Supabase Cloud Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=product-media

# Pricing Defaults
DEFAULT_EXCHANGE_RATE=3800

# AI Gateway (apikey.fun - Multi-Provider Routing)
APIKEY_FUN_BASE_URL=https://api.apikey.fun/v1
AI_ALLOWED_BASE_URLS=https://api.apikey.fun/v1,https://api.openai.com/v1
APIKEY_FUN_DEFAULT_MODEL=gemini-3.8-flash

# Backend Secure Keys (Chỉ lưu trên Backend, không bao giờ lộ ra Client)
APIKEY_FUN_GEMINI_KEY=your-apikey-fun-gemini-key
APIKEY_FUN_OPENAI_KEY=your-apikey-fun-openai-key
APIKEY_FUN_IMAGE_KEY=your-apikey-fun-image-key

# Default Key Fallback
APIKEY_FUN_API_KEY=your-apikey-fun-fallback-key
