# ==============================================================================
# 1688 LISTING SYNC HUB - ENVIRONMENT CONFIGURATION
# Cấu hình biến môi trường cho Vercel Dashboard & Local Development
# ==============================================================================

# 1. Cấu hình máy chủ
PORT=3001
NODE_ENV=production
EXTENSION_API_KEY=hub1688_secret_extension_key_2026

# 2. Cấu hình Supabase Cloud (Dự án: https://jpbrwfctgrufbdkstufq.supabase.co)
SUPABASE_URL=https://jpbrwfctgrufbdkstufq.supabase.co
# Lấy anon key từ Supabase Dashboard > Settings > API
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Lấy service_role key từ Supabase Dashboard > Settings > API (Dùng cho Backend để bypass RLS)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Tên bucket lưu trữ ảnh trên Supabase Storage
SUPABASE_STORAGE_BUCKET=product-media

# 3. Kết nối trực tiếp PostgreSQL (Tùy chọn nếu dùng Prisma)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# 4. Tùy chọn AI Engine (Tùy chọn)
GEMINI_API_KEY=
OPENAI_API_KEY=

# 5. Tỷ giá mặc định CNY sang VND
DEFAULT_EXCHANGE_RATE=3800
