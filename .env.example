# ==============================================================================
# 1688 LISTING SYNC HUB - ENVIRONMENT CONFIGURATION
# Cấu hình biến môi trường cho Vercel Dashboard & Local Development
# ==============================================================================

# 1. Cấu hình máy chủ
PORT=3001
NODE_ENV=production
ADMIN_API_TOKEN=
EXTENSION_API_KEY=
CRON_SECRET=
CORS_ALLOWED_ORIGINS=https://your-app.example.com
DEMO_MODE=false
JSON_BODY_LIMIT=5mb
OUTBOUND_TIMEOUT_MS=8000
OUTBOUND_MAX_BYTES=5242880

# 2. Cấu hình Supabase Cloud
SUPABASE_URL=https://your-project.supabase.co
# Lấy anon key từ Supabase Dashboard > Settings > API
SUPABASE_ANON_KEY=
# Lấy service_role key từ Supabase Dashboard > Settings > API (Dùng cho Backend để bypass RLS)
SUPABASE_SERVICE_ROLE_KEY=
# Tên bucket lưu trữ ảnh trên Supabase Storage
SUPABASE_STORAGE_BUCKET=product-media
SUPABASE_AUTH_URL=
SUPABASE_AUTH_ANON_KEY=
SUPABASE_AUTH_SERVICE_ROLE_KEY=
PUBLIC_APP_URL=https://your-production-domain.example

# 3. URL API cố định khi build Admin (để trống nếu API cùng origin)
VITE_API_BASE_URL=

# 4. AI Gateway tương thích OpenAI (tùy chọn, chỉ lưu phía máy chủ)
APIKEY_FUN_BASE_URL=https://api.apikey.fun/v1
AI_ALLOWED_BASE_URLS=https://api.apikey.fun/v1,https://api.openai.com/v1
APIKEY_FUN_DEFAULT_MODEL=gemini-3.8-flash
APIKEY_FUN_GEMINI_KEY=
APIKEY_FUN_OPENAI_KEY=
APIKEY_FUN_IMAGE_KEY=
APIKEY_FUN_API_KEY=

# 5. Tỷ giá mặc định CNY sang VND
DEFAULT_EXCHANGE_RATE=3800

# Connector credentials are server-only. Never expose them through VITE_* variables.
WOOCOMMERCE_STORE_URL=
WOOCOMMERCE_CONSUMER_KEY=
WOOCOMMERCE_CONSUMER_SECRET=
SHOPIFY_SHOP_DOMAIN=
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2025-01
SHOPIFY_STORE_CURRENCY=VND
# Required only when SHOPIFY_STORE_CURRENCY=USD
SHOPIFY_VND_PER_USD=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
